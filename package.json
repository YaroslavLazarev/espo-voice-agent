{
  "name": "espo-voice-agent",
  "private": true,
  "type": "module",
  "workspaces": [
    "shared",
    "backend",
    "frontend"
  ],
  "scripts": {
    "dev": "concurrently -n backend,frontend -c blue,green \"npm run dev -w backend\" \"npm run dev -w frontend\"",
    "typecheck": "npm run typecheck --workspaces",
    "lint": "eslint .",
    "test": "npm test --workspaces --if-present"
  },
  "devDependencies": {
    "@vue/eslint-config-typescript": "^14.9.0",
    "concurrently": "^10.0.7",
    "eslint": "^10.15.0",
    "eslint-plugin-vue": "^10.12.1",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.74.0"
  }
}
